# ============================================
# CRYPTO TRACE AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === Application ===
APP_NAME=CryptoTraceAI
APP_MODE=demo
# Options: "live" (real blockchain APIs) or "demo" (seeded data)

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./cryptotrace.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/cryptotrace

# === Authentication ===
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# === Blockchain Providers ===
# Bitcoin — No API key needed (uses Mempool.space / Blockstream)
BTC_API_URL=https://mempool.space/api
BTC_FALLBACK_API_URL=https://blockstream.info/api

# Ethereum — Public RPC (no key) + Etherscan (free key for token transfers)
ETH_RPC_URL=https://rpc.ankr.com/eth
ETH_EXPLORER_API_KEY=
# Get free key at https://etherscan.io/apis

# === Optional: Additional EVM Chains ===
POLYGON_RPC_URL=
POLYGON_EXPLORER_API_KEY=
BNB_RPC_URL=
BNB_EXPLORER_API_KEY=

# === AI (Optional) ===
OPENAI_API_KEY=
# Leave empty to use rule-based AI investigator

# === Rate Limits ===
BLOCKCHAIN_MAX_REQUESTS_PER_SECOND=5
TRACE_MAX_HOPS=10
TRACE_MAX_ADDRESSES_PER_HOP=20
TRACE_MAX_DURATION_SECONDS=300

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Logging ===
LOG_LEVEL=INFO
